---
import Button from "./Button.astro";

const { title, sub, variant, buttonVariant = "default" } = Astro.props;
---

<section class:list={["section--xs", `cta--${variant}`]}>
  <div class="content-width">
    <div class:list={["cta-inner", `cta-inner-${variant}`]}>
      <div>
        <h2>{title}</h2>
        <p class="lead">{sub}</p>
      </div>

      <Button
        href=`${import.meta.env.BASE_URL}/contact`
        content="Contact opnemen"
        variant={buttonVariant}
      />
    </div>
  </div>
</section>

<style>
  .cta--home {
    background: rgba(170, 201, 195, 0.5);
  }

  .cta--aanbod {
    background: var(--cream);
  }

  .cta--praktisch {
    background: var(--teal-dark);
    color: var(--white);
  }

  .cta-inner-home {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    border-radius: var(--space-lg);
    background: linear-gradient(
      to right,
      rgba(246, 242, 235, 1) 0%,
      rgba(246, 242, 235, 0.5) 60%,
      rgba(246, 242, 235, 0) 100%
    );
  }

  .cta-inner-aanbod {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    border-radius: var(--space-lg);
    background: linear-gradient(
      to right,
      rgb(255, 255, 255) 0%,
      rgba(246, 242, 235, 0.5) 60%,
      rgba(246, 242, 235, 0) 100%
    );
  }

  .cta-inner-praktisch {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cta-inner h2 {
    margin: 1rem 0;
    color: var(--gold);
  }
</style>
