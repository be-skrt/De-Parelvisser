---
const { title, heading = "h2", variant = "default" } = Astro.props;
const Heading = heading;
---

<div class:list={["title-container", `title--${variant}`]}>
  <Heading>{title}</Heading>

  <div class="pearl-line">
    <span></span>
  </div>
</div>

<style>
  .title-container {
    width: fit-content;
    margin-bottom: var(--space-lg);
  }

  .title-container.hero h1 {
    font-family: "Montserrat", sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .title--hero h1 {
    color: var(--teal);
    font-family: "Montserrat", sans-serif;
    font-size: var(--fsz-xxxl);
    font-weight: 300;
    letter-spacing: 0.08em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .title--hero .pearl-line {
    justify-content: flex-start;
    margin: 1.5rem 0;
  }

  .title--large h1 {
    font-size: var(--fsz-xxxl);
    font-weight: 300;
  }

  .pearl-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem auto;
  }

  .pearl-line::before,
  .pearl-line::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--gold);
  }

  .pearl-line span {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow:
      0 0 0 4px rgba(200, 134, 86, 0.12),
      0 2px 5px rgba(0, 0, 0, 0.15);
  }
</style>
