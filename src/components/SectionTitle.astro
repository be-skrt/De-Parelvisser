---
const { title, heading = "h2", variant = "default" } = Astro.props;
const Heading = heading;
---

<div class:list={["title-container", `title--${variant}`]}>
  <Heading>{title}</Heading>

  <div class="pearl-line">
    <span></span>
  </div>
</div>

<style>
  .title-container {
    width: fit-content;
    margin-bottom: var(--space-lg);
  }

  @media (max-width: 900px) {
    .title-container {
      margin-bottom: var(--space-md);
    }
  }

  @media (max-width: 500px) {
    .title-container {
      margin-bottom: 0;
    }
  }

  .title-container h1 {
    font-size: var(--fsz-xxl);
  }

  .title-container h1,
  .title-container h2 {
    @media (max-width: 768px) {
      text-align: center;
    }
  }
  .title--hero {
    margin: 0;
  }

  .title--hero h1 {
    font-size: clamp(2rem, 5vw, 6rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    line-height: 0.95;
    text-transform: uppercase;

    @media (max-width: 450px) {
      
    }
  }

  .title--hero .pearl-line {
    justify-content: flex-start;
    margin: var(--space-md) 0;
  }

  .title--large h1 {
    font-size: var(--fsz-xxxl);
    font-weight: 300;
  }

  .pearl-line {
    display: flex;
    align-items: center;
    gap: 5%;
    margin: var(--space-sm) auto;
  }

  .pearl-line::before,
  .pearl-line::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--gold);
  }

  .pearl-line span {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--gold);
    box-shadow:
      0 0 0 4px rgba(200, 134, 86, 0.12),
      0 2px 5px rgba(0, 0, 0, 0.15);
  }
</style>
