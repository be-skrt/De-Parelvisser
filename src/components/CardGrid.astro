---
import Card from "./Card.astro";

interface CardItem {
  href?: string;
  title: string;
  text: string;
  price?: string;
  variant?: string;
  icon?: string;
  iconColors?: {
    main?: string;
    secondary?: string;
    accent?: string;
  };
  opacity?: string;
}

const { columns = 3, items = [] } = Astro.props;
---

<div class="card-grid" style={`--columns: ${columns}`}>
  {
    items.map((item: CardItem, index: number) => (
      <Card index={index} {...item} />
    ))
  }
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    width: 100%;

    @media (max-width: 900px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xs);
    }

    @media (max-width: 550px) {
      grid-template-columns: 1fr;
    }
  }
</style>
