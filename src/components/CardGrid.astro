---
import Card from "./Card.astro";

interface CardItem {
  href?: string;
  title: string;
  text: string;
  price?: string;
  variant?: string;
  icon?: string;
  iconColors?: {
    main?: string;
    secondary?: string;
    accent?: string;
  };
  opacity?: string | number;
}

interface Props {
  columns?: string;
  items?: CardItem[];
  carousel?: boolean;
  ariaLabel?: string;
}

const {
  columns = "3",
  items = [],
  carousel = parseInt(columns) > 3 ? true : false,
  ariaLabel = "Kaarten",
}: Props = Astro.props;
---

<div
  class:list={["card-grid", { "card-grid--carousel": carousel }]}
  role={carousel ? "region" : null}
  aria-label={carousel ? ariaLabel : null}
  tabindex={carousel ? 0 : null}
  style={`--columns: ${columns}`}
>
  {
    items.map((item: CardItem, index: number) => (
      <Card index={index} {...item} />
    ))
  }
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
    width: 100%;

    @media (max-width: 900px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xs);
    }
  }

  @media (max-width: 550px) {
    .card-grid:not(.card-grid--carousel) {
      grid-template-columns: 1fr;
    }

    .card-grid--carousel {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--space-sm);
      overflow-x: auto;
      overflow-y: hidden;
      padding: var(--space-lg);
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }

    .card-grid--carousel > :global(.card) {
      flex: 0 0 85%;
      min-width: 200px;
      scroll-snap-align: start;
    }
  }
</style>
