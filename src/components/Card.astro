---
import Icon from "./icons/Icon.astro";

const {
  href,
  title,
  text,
  price,
  index,
  variant = "white",
  icon = "oyster",
  iconColors = {},
  opacity = 1,
} = Astro.props;
---

{
  href ? (
    <a
      id={`card-${index + 1}`}
      class:list={["card", "text--center", `card--${variant}`]}
      href={href}
    >
      {icon && (
        <div
          class="card-icon"
          style={`
          --icon-color: ${iconColors.main ?? "var(--teal)"};
          --icon-color-2: ${iconColors.secondary ?? iconColors.main ?? "var(--teal)"};
          --icon-color-3: ${iconColors.accent ?? iconColors.main ?? "var(--teal)"};
          --opacity: ${opacity};
        `}
        >
          <Icon name={icon} />
        </div>
      )}
      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
      {price ? (
        <strong class="card-price">{price}</strong>
      ) : (
        <span class="card-link">Meer info →</span>
      )}
    </a>
  ) : (
    <article
      id={`card-${index + 1}`}
      class:list={["card", "text--center", `card--${variant}`]}
    >
      <div
        class="card-icon"
        style={`
          --icon-color: ${iconColors.main ?? "var(--teal)"};
          --icon-color-2: ${iconColors.secondary ?? iconColors.main ?? "var(--teal)"};
          --icon-color-3: ${iconColors.accent ?? iconColors.main ?? "var(--teal)"};
          --opacity: ${opacity};
        `}
      >
        <Icon name={icon} />
      </div>

      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
        {price && <strong class="card-price">{price}</strong>}
      </div>
    </article>
  )
}

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-md);
    gap: var(--space-sm);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-md);
    background: var(--card-background);
    color: var(--card-text);
    box-shadow: 1px 2px 15px var(--card-shadow);
    transition:
      transform var(--transition),
      box-shadow var(--transition);

    @media (max-width: 768px) {
      padding: var(--space-sm);
    }

    @media (max-width: 550px) {
      gap: var(--space-xs);
    }
  }

  a.card {
    text-decoration: none;
  }

  a.card:hover {
    transform: translateY(-6px);
    box-shadow: 1px 2px 15px var(--card-shadow-soft);
  }

  .card--white {
    --card-background: var(--white);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
    --card-shadow: rgba(40, 83, 99, 0.3);
    --card-shadow-soft: rgba(40, 83, 99, 0.1);
  }

  .card--cream {
    --card-background: var(--cream);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
    --card-shadow: rgba(33, 68, 81, 0.3);
    --card-shadow-soft: rgba(33, 68, 81, 0.1);
  }

  .card--teal {
    --card-background: var(--teal);
    --card-border: var(--teal);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--gold);
    --card-shadow: rgba(13, 29, 35, 0.3);
    --card-shadow-soft: rgba(13, 29, 35, 0.1);
  }

  .card-icon {
    display: flex;
    justify-content: center;
    align-self: center;
    width: clamp(50px, 2.5rem, 75px);
    opacity: var(--opacity);
    color: var(--icon-color);

    @media (max-width: 320px) {
      display: none;
    }
  }

  .card-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .card-title {
    color: var(--card-title);
    text-transform: uppercase;
    font-size: var(--fsz-md);
  }

  .card-description {
    margin: 0;
    font-size: var(--fsz-sm);
  }

  .card-price {
    color: var(--card-title);
    font-family: "Montserrat", sans-serif;
    font-size: var(--fsz-lg);
    font-weight: 400;
  }

  .card-link {
    margin-top: auto;
    color: var(--card-link);
    font-family: "Montserrat", sans-serif;
    font-size: var(--fsz-sm);
  }
</style>
