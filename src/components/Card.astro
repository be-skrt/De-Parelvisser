---
import OysterIcon from "./OysterIcon.astro";

const {
  href,
  title,
  text,
  index,
  variant = "default",
  shell = "default"
} = Astro.props;
---

{

  href ? (
    <a
      id={`card-${index}`}
      class:list={["card", "text--center", `card--${variant}`, `card--shell-${shell}`]}
      href={href}
    >
      <div class="card-icon">
        <OysterIcon />
      </div>
      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
      <span class="card-link">Meer info →</span>
    </a>
  ) : (
    <article
      id={`card-${index}`}
      class:list={["card", "text--center", `card--${variant}`, `card--shell-${shell}`]}
    >
      <div class="card-icon">
        <OysterIcon />
      </div>

      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
    </article>
  )
}

