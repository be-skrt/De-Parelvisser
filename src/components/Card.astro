  .card {
    /* -------------------------
     Basis
  ------------------------- */

    position: relative;
    display: flex;
    flex-direction: column;

    min-height: 300px;
    padding: var(--space-lg);
    gap: var(--space-lg);

    border: 1px solid var(--card-border);
    border-radius: 1rem;

    background: var(--card-background);
    color: var(--card-text);

    box-shadow: var(--shadow-card);

    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  /* -------------------------
   Link-kaarten
------------------------- */

  a.card {
    text-decoration: none;
  }

  a.card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-soft);
  }

  /* -------------------------
   Kleurvarianten
------------------------- */

  /* Standaard */
  .card--default {
    --card-background: linear-gradient(
      to bottom,
      rgba(246, 242, 235, 1) 10%,
      rgba(246, 242, 235, 0.65) 100%
    );

    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  /* Teal */
  .card--teal {
    --card-background: var(--teal);
    --card-border: var(--teal);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--white);
  }

  .card--teal-light {
    --card-background: var(--teal-light);
    --card-border: var(--teal-light);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--white);
  }

  /* Wit */
  .card--white {
    --card-background: var(--white);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  /* Cream */
  .card--cream {
    --card-background: var(--cream);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  /* -------------------------
   Icon
------------------------- */

  .card-icon {
    display: flex;
    justify-content: center;
    align-self: center;

    width: clamp(50px, 2.5rem, 75px);

    opacity: 0.4;
  }

  /* -------------------------
   Tekst
------------------------- */

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-title {
    color: var(--card-title);

    text-transform: uppercase;
    font-size: var(--fsz-md);
  }

  .card-description {
    font-size: 0.95rem;
  }

  /* -------------------------
   Link
------------------------- */

  .card-link {
    margin-top: auto;

    color: var(--card-link);

    font-family: "Montserrat", sans-serif;
    font-size: 0.85rem;
  }

  /* -------------------------
   Schelpvarianten
------------------------- */

  .card--shell-default .card-icon {
    color: var(--teal);
  }

  .card--shell-gold .card-icon {
    color: var(--gold);
  }

  .card--shell-white .card-icon {
    color: var(--white);
  }

  .card--shell-teal-light .card-icon {
    color: var(--teal-light);
  }
</style>
