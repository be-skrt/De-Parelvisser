---
import OysterIcon from "./OysterIcon.astro";

const {
  href,
  title,
  text,
  index,
  variant = "default",
  shell = "default",
  pearl = "default",
} = Astro.props;
---

{
  href ? (
    <a
      id={`card-${index + 1}`}
      class:list={[
        "card",
        "text--center",
        `card--${variant}`,
        `card--shell-${shell}`,
        `card--pearl-${pearl}`,
      ]}
      href={href}
    >
      <div class="card-icon">
        <OysterIcon />
      </div>
      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
      <span class="card-link">Meer info →</span>
    </a>
  ) : (
    <article
      id={`card-${index + 1}`}
      class:list={[
        "card",
        "text--center",
        `card--${variant}`,
        `card--shell-${shell}`,
        `card--pearl-${pearl}`,
      ]}
    >
      <div class="card-icon">
        <OysterIcon />
      </div>

      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
    </article>
  )
}

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: var(--space-lg);
    gap: var(--space-lg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    background: var(--card-background);
    color: var(--card-text);
    box-shadow: var(--shadow-card);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  a.card {
    text-decoration: none;
  }

  a.card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-soft);
  }

  .card--default {
    --card-background: linear-gradient(
      to bottom,
      rgba(246, 242, 235, 1) 10%,
      rgba(246, 242, 235, 0.65) 100%
    );

    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  .card--teal {
    --card-background: var(--teal);
    --card-border: var(--teal);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--white);
  }

  .card--teal-light {
    --card-background: var(--teal-light);
    --card-border: var(--teal-light);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--white);
  }

  .card--white {
    --card-background: var(--white);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  .card--sage {
    --card-background: var(--sage);
    --card-border: var(--sage);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  .card--cream {
    --card-background: var(--cream);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  .card-icon {
    display: flex;
    justify-content: center;
    align-self: center;
    width: clamp(50px, 2.5rem, 75px);
    opacity: 0.4;
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-title {
    color: var(--card-title);
    text-transform: uppercase;
    font-size: var(--fsz-md);
  }

  .card-description {
    font-size: 0.95rem;
  }

  .card-link {
    margin-top: auto;
    color: var(--card-link);
    font-family: "Montserrat", sans-serif;
    font-size: 0.85rem;
  }

  .card--shell-default {
    --oyster-shell-color: var(--teal);
  }

  .card--shell-gold {
    --oyster-shell-color: var(--gold);
  }

  .card--shell-white {
    --oyster-shell-color: var(--white);
  }

  .card--shell-teal-light {
    --oyster-shell-color: var(--teal-light);
  }

  .card--pearl-default {
    --oyster-pearl-color: var(--gold-light);
  }

  .card--pearl-gold {
    --oyster-pearl-color: var(--gold);
  }

  .card--pearl-teal {
    --oyster-pearl-color: var(--teal);
  }

  .card--pearl-white {
    --oyster-pearl-color: var(--white);
  }
</style>
