---
import Icon from "./Icon.astro";

const {
  href,
  title,
  text,
  index,
  variant = "white",
  icon = "oyster",
  iconColors = {},
  opacity = 1,
} = Astro.props;
---

{
  href ? (
    <a
      id={`card-${index + 1}`}
      class:list={[
        "card",
        "text--center",
        `card--${variant}`,
      ]}
      href={href}
    >
      <div
        class="card-icon"
        style={`
          --icon-color: ${iconColors.main ?? "var(--teal)"};
          --icon-color-2: ${iconColors.secondary ?? iconColors.main ?? "var(--teal)"};
          --icon-color-3: ${iconColors.accent ?? iconColors.main ?? "var(--teal)"};
          --opacity: ${opacity ?? opacity};
        `}
      >
        <Icon name={icon} />
      </div>
      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
      <span class="card-link">Meer info →</span>
    </a>
  ) : (
    <article
      id={`card-${index + 1}`}
      class:list={[
        "card",
        "text--center",
        `card--${variant}`,
      ]}
    >
      <div
        class="card-icon"
        style={`
          --icon-color: ${iconColors.main ?? "var(--teal)"};
          --icon-color-2: ${iconColors.secondary ?? iconColors.main ?? "var(--teal)"};
          --icon-color-3: ${iconColors.accent ?? iconColors.main ?? "var(--teal)"};
          --opacity: ${opacity ?? opacity};
        `}
      >
        <Icon name={icon} />
      </div>

      <div class="card-text">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{text}</p>
      </div>
    </article>
  )
}

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: var(--space-lg);
    gap: var(--space-lg);
    border: 1px solid var(--card-border);
    border-radius: 1rem;
    background: var(--card-background);
    color: var(--card-text);
    box-shadow: 1px 2px 15px var(--card-shadow);
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  a.card {
    text-decoration: none;
  }

  a.card:hover {
    transform: translateY(-6px);
    box-shadow: 1px 2px 15px var(--card-shadow-soft);
  }

  .card--white {
    --card-background: var(--white);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
    --card-shadow: rgba(40, 83, 99, 0.3);
    --card-shadow-soft: rgba(40, 83, 99, 0.1);
  }

  .card--cream {
    --card-background: var(--cream);
    --card-border: var(--cream);
    --card-text: var(--teal);
    --card-title: var(--gold);
    --card-link: var(--gold);
    --card-shadow: rgba(33, 68, 81, 0.3);
    --card-shadow-soft: rgba(33, 68, 81, 0.1);
  }

  .card--teal {
    --card-background: var(--teal);
    --card-border: var(--teal);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--gold);
  }

  .card--teal-light {
    --card-background: var(--teal-light);
    --card-border: var(--teal-light);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--white);
  }

  .card--teal-dark {
    --card-background: var(--teal-dark);
    --card-border: var(--teal-dark);
    --card-text: var(--white);
    --card-title: var(--gold);
    --card-link: var(--white);
  }

  .card-icon {
    display: flex;
    justify-content: center;
    align-self: center;
    width: clamp(50px, 2.5rem, 75px);
    opacity: var(--opacity);
    color: var(--icon-color);
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-title {
    color: var(--card-title);
    text-transform: uppercase;
    font-size: var(--fsz-md);
  }

  .card-description {
    font-size: 0.95rem;
  }

  .card-link {
    margin-top: auto;
    color: var(--card-link);
    font-family: "Montserrat", sans-serif;
    font-size: 0.85rem;
  }
</style>
