---
import OysterIcon from "./icons/OysterIcon.astro";
import Button from "./Button.astro";
import SectionTitle from "./SectionTitle.astro";

const { businessName } = Astro.props;
---

<section class="hero section--small">
  <div class="content-width hero-inner">
    <div class="hero-content">
      <p class="eyebrow text--gold">Psychologenpraktijk</p>
      <SectionTitle title={businessName} heading="h1" variant="hero" />
      <p class="hero-tagline">Ruimte om te groeien</p>
      <Button
        href=`${import.meta.env.BASE_URL}/werkwijze`
        content="Ontdek mijn werkwijze"
      />
    </div>

    <figure
      class="hero-oyster"
      data-aos="fade-in"
      data-aos-delay="400"
      data-aos-duration="800"
    >
      <OysterIcon shellColor="var(--teal)" pearlColor="var(--gold-light)" />
    </figure>
  </div>

  <div class="waves" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 24 150 28"
      shape-rendering="auto"
      preserveAspectRatio="xMidYMax slice"
    >
      <defs>
        <path
          id="gentle-wave"
          d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"
        ></path>
      </defs>
      <g class="parallax">
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="0"
          opacity="0.3"
          fill="var(--gold-light)"></use>
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="3"
          opacity="0.5"
          fill="var(--blue-soft)"></use>
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="5"
          opacity="0.7"
          fill="var(--sage)"></use>
        <use
          xlink:href="#gentle-wave"
          x="48"
          y="7"
          opacity="1"
          fill="var(--teal)"></use>
      </g>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
  }

  .hero-inner {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xl);

    @media (max-width: 768px) {
      flex-direction: column;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: relative;
    width: fit-content;
    z-index: 2;

    @media (max-width: 768px) {
      align-items: center;
    }
  }

  .title--hero .pearl-line {
    justify-content: flex-start;
    margin: 1.5rem 0;
  }

  .hero-tagline {
    display: flex;
    align-self: flex-end;
    margin-bottom: var(--space-lg);
    color: var(--teal-light);
    font-family: "Montserrat";
    font-style: italic;
    font-size: var(--fsz-lg);
    line-height: 1.2;

    @media (max-width: 768px) {
      align-self: center;
    }
  }

  .hero-oyster {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 33%;
    aspect-ratio: 1;

    @media (max-width: 768px) {
      position: absolute;
      top: 25%;
      width: 65%;
      opacity: 0.25;
    }
  }

  .waves {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: var(--wave-height, 20vh);
    z-index: 1;
  }

  .waves svg {
    width: 100%;
    height: var(--wave-height);
    overflow: visible;
  }

  .parallax > use {
    animation: flow 30s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
  }
  .parallax > use:nth-child(1) {
    animation-delay: -2s;
    animation-duration: 9s;
  }
  .parallax > use:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 11s;
  }
  .parallax > use:nth-child(3) {
    animation-delay: -4s;
    animation-duration: 15s;
  }
  .parallax > use:nth-child(4) {
    animation-delay: -5s;
    animation-duration: 20s;
  }
</style>
