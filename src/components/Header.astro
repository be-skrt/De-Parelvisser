---
import Logo from "./Logo.astro";

const { currentPath } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const links = [
  { href: `${baseUrl}/`, label: "Home" },
  { href: `${baseUrl}/werkwijze`, label: "Werkwijze" },
  { href: `${baseUrl}/aanbod`, label: "Aanbod" },
  { href: `${baseUrl}/praktisch`, label: "Praktisch" },
  { href: `${baseUrl}/over-mij`, label: "Over mij" },
  { href: `${baseUrl}/contact`, label: "Contact" },
];

const isPathActive = (linkHref: string) => {
  const currentUrl = new URL(currentPath, "https://be-skrt.github.io");
  const linkUrl = new URL(linkHref, "https://be-skrt.github.io");
  const cleanCurrent = currentUrl.pathname.replace(/\/$/, "");
  const cleanLink = linkUrl.pathname.replace(/\/$/, "");
  const cleanBase = baseUrl.replace(/\/$/, "");

  if (cleanLink === cleanBase || cleanLink === "") {
    return cleanCurrent === cleanBase || cleanCurrent === "";
  }
  return cleanCurrent === cleanLink;
};

const isHomeActive = isPathActive(`${baseUrl}/`);
---

<header class:list={["header", { home: isHomeActive }]} id="header">
  <div class="content-width header-inner">
    <Logo />
    <nav id="navbar">
      <ul>
        {
          links.map((link) => {
            const isActive = isPathActive(link.href);

            return (
              <li>
                <a
                  href={link.href}
                  class={isActive ? "active" : ""}
                  aria-current={isActive ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <button
      id="menu-button"
      class="menu-toggle"
      type="button"
      aria-label="Navigatie openen"
      aria-expanded="false"
      aria-controls="navbar"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<script>
  const button = document.getElementById("menu-button");
  const nav = document.getElementById("navbar");

  button?.addEventListener("click", () => {
    const open = button.classList.toggle("open");

    nav?.classList.toggle("open", open);
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute(
      "aria-label",
      open ? "Navigatie sluiten" : "Navigatie openen",
    );

    document.body.style.overflow = open ? "hidden" : "";
  });
</script>

<style>
  header {
    position: relative;
    top: 0;
    z-index: 11;
    width: 100%;
    height: var(--header-height);
    background: transparent;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  @media (max-width: 500px) {
    header {
      height: calc(var(--header-height) * 0.8);
    }
  }

  header.home,
  header.scroll {
    position: fixed;
  }

  header .content-width {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* -----------------------------
    NAV
  ----------------------------- */

  nav {
    width: auto;
    margin-left: auto;
  }

  nav ul {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    position: relative;
    padding: var(--space-xs) 0.75rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--teal);
    font-family: "Montserrat", sans-serif;
    font-size: var(--fsz-sm);
    letter-spacing: 0.01rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  nav a:hover {
    background-color: var(--teal);
    color: var(--white);
  }

  nav a.active,
  nav a.active:hover {
    color: var(--gold);
    background: transparent;
  }

  /* -----------------------------
    SCROLLED HEADER
  ----------------------------- */

  header.scroll {
    background: var(--teal);
  }

  header.scroll nav a {
    color: var(--white);
  }

  header.scroll nav a:hover {
    color: var(--teal);
    background: var(--white);
  }

  header.scroll nav a.active,
  header.scroll nav a.active:hover {
    color: var(--gold);
    background: transparent;
  }

  /* -----------------------------
    HAMBURGER MENU
  ----------------------------- */

  .menu-toggle {
    display: none;

    @media (max-width: 900px) {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 2rem;
      height: 1.5rem;
      margin-right: var(--space-md);
      padding: 0.2rem;
      border: none;
      background: transparent;
      cursor: pointer;
      position: relative;
      z-index: 10;
    }
  }

  @media (max-width: 900px) {
    .menu-toggle span {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--teal);
      border-radius: var(--radius-pill);
      transition:
        transform var(--transition),
        opacity var(--transition);
    }

    header.scroll .menu-toggle span {
      background: var(--white);
    }

    .menu-toggle.open span:nth-child(1) {
      transform: translateY(0.5rem) rotate(45deg);
    }

    .menu-toggle.open span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.open span:nth-child(3) {
      transform: translateY(-0.5rem) rotate(-45deg);
    }

    .menu-toggle.open span {
      background: var(--white);
    }

    nav {
      position: fixed;
      z-index: 9;
      inset: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100vw;
      height: 100vh;
      background: var(--teal);
      color: var(--white);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      overflow-y: hidden;
      transition:
        opacity var(--transition),
        visibility var(--transition);
    }

    nav::before {
      content: "";
      position: absolute;
      background: var(--white);
      mask: url("../assets/oyster.svg") no-repeat center;
      mask-size: min(80vw, 45rem);
      -webkit-mask: url("../assets/oyster.svg") no-repeat center;
      -webkit-mask-size: min(80vw, 45rem);
      opacity: 0.08;
      pointer-events: none;
    }

    nav.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      overscroll-behavior: contain;
      overflow: hidden;
    }

    nav ul {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-md);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    nav a {
      color: var(--white);
      font-family: "Montserrat", sans-serif;
      font-size: var(--fsz-xl);
      text-decoration: none;
    }

    nav a:hover {
      color: var(--white);
    }

    nav a.active,
    nav a.active:hover {
      color: var(--gold);
      background: transparent;
    }
  }
</style>
