---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<a class="logo" href=`${import.meta.env.BASE_URL}/` aria-label=`De Parelvisser - Home`>
  <Image
    src={logo}
    alt="De Parelvisser logo"
    loading="eager"
    class="logo-image" />
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-image {
    display: block;
    width: auto;
    height: 4rem;
    max-width: 180px;
  }
</style>
