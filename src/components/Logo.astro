---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import withBase from "../utils/withBase";

interface Props {
  loading?: "eager" | "lazy";
}

const { loading = "lazy" } = Astro.props;
---

{

}
<a class="logo" href={withBase("")} aria-label="De Parelvisser - Home">
  <Image
    src={logo}
    alt="De Parelvisser logo"
    loading={loading}
    class="logo-image" />
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-image {
    display: block;
    width: auto;
    height: var(--space-xl);
    max-width: 180px;
  }
</style>
