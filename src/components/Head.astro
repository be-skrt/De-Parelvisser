---
import BaseSEO from "./BaseSEO.astro";
import withBase from "../utils/withBase";

const { title, description } = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <link rel="icon" type="image/png" sizes="192x192" href={withBase("favicon.png")} />
  <link rel="icon" type="image/x-icon" href={withBase("favicon.ico")} />
  
  <link rel="sitemap" type="application/xml" href={withBase("sitemap-index.xml")} />
  
  <BaseSEO title={title} description={description} />
</head>
