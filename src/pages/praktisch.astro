---
import MainLayout from "../layouts/MainLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import CTA from "../components/CTA.astro";

const prices = [
  {
    service: "Individueel gesprek",
    duration: "± 50 minuten",
    price: "€75",
  },
  {
    service: "Gezinsgesprek",
    duration: "± 1u 15min",
    price: "€90",
  },
  {
    service: "Diagnostiek",
    duration: "Inclusief testafname en verslag",
    price: "vanaf €250",
  },
  {
    service: "Bespreking resultaten",
    duration: "Per sessie",
    price: "€75",
  },
];
---

<MainLayout title="Praktisch">
  <section class="section section--white section--center">
    <div class="content-width section--center section--col text--center">
      <SectionTitle title="Praktisch" heading="h1" />

      <p class="lead">
        Alles wat je moet weten over afspraken, tarieven en terugbetaling.
      </p>
    </div>
  </section>

  <section class="section--small section--teal">
    <div class="content-width section--center section--col text--center">
      <SectionTitle heading="h2" title="Afspraak maken" />
      <div>
        <p class="lead">
          Contactgegevens vind je terug onder <a
            class="contact-link"
            href=`${import.meta.env.BASE_URL}/contact`>Contact</a
          >.
        </p>
        <p>
          Wanneer je contact opneemt, mag je kort je vraag of reden van
          aanmelding meegeven. Zo kan ik inschatten wat de beste volgende stap
          is.
        </p>
        <p>We plannen vervolgens samen een eerste afspraak in.</p>
      </div>
    </div>
  </section>

  <section class="section--small section--white section--oyster-teal">
    <div class="content-width section--center section--col text--center">
      <SectionTitle heading="h2" title="Geconventioneerde zorg" />
      <p>
        Ik ben <strong>geconventioneerd psycholoog</strong>. Binnen het
        conventiesysteem gelden de tarieven en voorwaarden die door de overheid
        en de conventie bepaald worden.
      </p>
      <p>
        Sessies kunnen binnen dit systeem gedeeltelijk of volledig worden
        terugbetaald volgens de geldende regels.
      </p>
      <p>
        Bij een geconventioneerd traject is het aangewezen om de noodzaak van
        psychologische begeleiding vooraf te bespreken met bijvoorbeeld de
        huisarts, het CLB of Kind en Gezin.
      </p>
    </div>
  </section>

  <section class="section--small">
    <section class="content-width section--center section--col">
      <div class="section--center section--col text--center heading">
        <SectionTitle heading="h2" title="Buiten de conventie" />
        <p class="lead">
          Daarnaast werk ik ook deels als zelfstandige buiten de conventie. Voor
          deze afspraken gelden onderstaande tarieven.
        </p>
      </div>
      <div class="content-width section--center price-grid">
        {
          prices.map((item) => (
            <article class="price-card">
              <h3 class="card-title">{item.service}</h3>

              <p class="lead">{item.duration}</p>

              <strong class="card-price">{item.price}</strong>
            </article>
          ))
        }
      </div>
      <div class="additional-info">
        <h3>Bijkomende diagnostiek</h3>
        <p>
          Naast de intelligentietest kunnen bijkomende tests worden afgenomen.
          Welke tests aangewezen zijn, wordt samen besproken.
        </p>
      </div>
    </section>
  </section>

  <section class="section--small section--teal section--oyster-white">
    <div class="content-width section--center section--col text--center">
      <SectionTitle heading="h2" title="Praktische mogelijkheden" />

      <div class="practical-grid">
        <article class="practical-card">
          <h3>Gesprekken aan huis</h3>
          <p>
            Gesprekken aan huis zijn mogelijk. Hiervoor wordt een extra
            verplaatsingskost aangerekend, afhankelijk van de afstand.
          </p>
        </article>

        <article class="practical-card">
          <h3>Online gesprekken</h3>
          <p>
            Online gesprekken zijn mogelijk wanneer dit aangewezen is en in
            overleg.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section--small section--white">
    <div class="content-width section--center section--col text--center">
      <SectionTitle heading="h2" title="Voor professionelen" />

      <div class="professional-grid">
        <article class="professional-card">
          <h3>Supervisie en intervisie</h3>
          <p>
            Voor supervisie en intervisie geldt hetzelfde tarief als voor een
            individueel gesprek.
          </p>
          <strong>€75 per uur</strong>
        </article>

        <article class="professional-card">
          <h3>Vorming</h3>
          <p>Voor vorming wordt een offerte op maat opgesteld.</p>
          <strong>Prijs op aanvraag</strong>
        </article>
      </div>
    </div>
  </section>

  <CTA
    title="Heb je vragen over een tarief of terugbetaling?"
    sub="Neem gerust contact op. We bekijken samen wat van toepassing is op jouw situatie."
    variant="praktisch"
    buttonVariant="light"
  />
</MainLayout>

<style>
  .contact-link {
    color: var(--gold);
  }

  .contact-link:hover {
    color: var(--white);
  }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .price-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);

    background: var(--white);
    color: var(--teal);

    border-radius: var(--radius-md);
    box-shadow: var(--card-shadow);

    --card-shadow: 0 2px 15px rgba(40, 83, 90, 0.4);
  }

  .card-title {
    font-size: var(--fsz-lg);
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .price-card p {
    color: var(--muted);
  }

  .price-card strong {
    color: var(--gold);
    font-family: "Montserrat", sans-serif;
    font-size: 2rem;
    font-weight: 400;
  }

  .additional-info {
    position: relative;
    width: 100%;
    max-width: 800px;
    padding: var(--space-lg);
    border: 1px solid var(--white);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }

  .additional-info h3 {
    margin-bottom: var(--space-sm);
    color: var(--gold);
  }

  .additional-info p {
    margin: 0;
  }

  .additional-info::after {
    content: "";
    position: absolute;
    width: 50%;
    aspect-ratio: 1;
    right: 0;
    bottom: 0;
    background-color: var(--teal);
    opacity: 0.2;
    mask: url("../assets/falling-oysters.svg") no-repeat center;
    mask-size: contain;
    transform: translate(20%, 25%) rotate(30deg);
    pointer-events: none;
  }

  .practical-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .practical-card {
    padding: var(--space-lg);

    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md);

    background: rgba(255, 255, 255, 0.08);
  }

  .practical-card h3 {
    margin-bottom: 0.75rem;
    color: var(--gold);
  }

  .practical-card p {
    margin: 0;
  }

  .professional-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .professional-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);

    border: 1px solid var(--cream);
    border-radius: var(--radius-md);

    background: var(--white);
    color: var(--teal);
    box-shadow: var(--card-shadow);
    --card-shadow: 0 2px 15px rgba(40, 83, 90, 0.4);
  }

  .professional-card h3 {
    margin: 0;
    color: var(--gold);
  }

  .professional-card p {
    margin: 0;
  }

  .professional-card strong {
    margin-top: auto;
    color: var(--gold);

    font-family: "Montserrat", sans-serif;
    font-weight: 400;
  }

  .practical-note {
    background: var(--sage);
  }

  .practical-note > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .practical-note h2 {
    margin-bottom: 0.5rem;
  }

  .practical-note p {
    margin: 0;
  }

  @media (max-width: 750px) {
    .price-grid,
    .practical-grid,
    .professional-grid {
      grid-template-columns: 1fr;
    }

    .practical-grid,
    .convention-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .price-grid {
      grid-template-columns: 1fr;
    }

    .practical-note > div {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
