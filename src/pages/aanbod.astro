---
import MainLayout from "../layouts/MainLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import CTA from "../components/CTA.astro";

const services = [
  {
    id: "ouder-kind",
    title: "Ouder-kind gesprekken",
    intro:
      "Voor jonge ouders, baby's en peuters staat de relatie tussen ouder en kind centraal.",
    paragraphs: [
      "Bij de allerkleinsten werk ik steeds samen met de ouder(s). Het jonge kind kan zich nog niet via woorden uitdrukken, waardoor de relatie met de ouder de belangrijkste ingang vormt.",
      "We vertrekken vanuit hechting en co-regulatie: hoe kunnen ouder en kind elkaar beter aanvoelen, tot rust komen en op elkaar afgestemd raken?",
      "We kijken samen naar signalen van het kind, naar de interactie tussen ouder en kind en naar wat helpend kan zijn in het versterken van veiligheid en verbinding.",
    ],
    icon: "parent",
  },

  {
    id: "diagnostiek",
    title: "Diagnostiek",
    intro:
      "Diagnostiek helpt om beter te begrijpen wat er speelt en wat nodig is.",
    paragraphs: [
      "Ik werk niet enkel met testen, maar kijk samen met jou naar het geheel: via gesprekken, observaties en waar nodig aanvullend onderzoek.",
      "We zoeken naar samenhang en betekenis, zodat duidelijk wordt wat helpend kan zijn in het verdere traject.",
    ],
    list: [
      "Intelligentietest",
      "Hechtingsonderzoek",
      "Belevingsonderzoek",
      "Vragenlijsten",
      "Klasobservatie",
    ],
    icon: "diagnosis",
  },

  {
    id: "therapie",
    title: "Individuele therapie",
    intro:
      "Een veilige ruimte waarin kinderen, jongeren en jongvolwassenen op hun eigen tempo kunnen stilstaan bij wat moeilijk loopt.",
    paragraphs: [
      "De manier van werken wordt steeds afgestemd op leeftijd, ontwikkeling en persoonlijke noden.",
      "Therapie is geen vaststaand programma, maar een traject op maat.",
    ],
    icon: "therapy",
  },

  {
    id: "ouders-gezin",
    title: "Ouders & gezin",
    intro: "Ondersteuning rond opvoeding, relaties en gezinsdynamieken.",
    paragraphs: [
      "Ouderbegeleiding biedt een plek om stil te staan bij vragen en onzekerheden in de opvoeding.",
      "In gezinstherapie staat de interactie binnen het gezin centraal. Moeilijkheden worden bekeken in de context van relaties en onderlinge dynamieken.",
    ],
    icon: "family",
  },

  {
    id: "context",
    title: "Contextbegeleiding",
    intro: "Soms spelen moeilijkheden zich niet alleen binnen het gezin af.",
    paragraphs: [
      "Omdat moeilijkheden vaak verbonden zijn met de relaties waarin iemand leeft, betrek ik waar nodig de context. Dit kan het gezin zijn, maar ook school of andere belangrijke omgevingen. Dit helpt om een vollediger beeld te krijgen en meer afgestemde ondersteuning te bieden.",
      "Ik werk in verschillende vormen: soms individueel, soms met ouders, soms samen met het kind of de jongere en zijn of haar omgeving. Dit gebeurt steeds in overleg en afstemming.",
    ],
    icon: "school",
  },

  {
    id: "professionals",
    title: "Professionals",
    intro:
      "Ook professionals kunnen terecht voor ondersteuning en verdieping in hun werk.",
    paragraphs: [
      "Ik bied supervisie, intervisie en vorming aan, afgestemd op de werkcontext en de noden van de professional.",
    ],
    icon: "professional",
  },
];

const emdr = {
  title: "EMDR",
  paragraphs: [
    "In sommige situaties kan EMDR helpend zijn, bijvoorbeeld wanneer ingrijpende ervaringen blijven doorwerken in het dagelijks leven.",
    "EMDR (Eye Movement Desensitization and Reprocessing) is een psychotherapeutische behandelmethode die onder meer wordt gebruikt bij traumatische ervaringen en angstklachten.",
  ],
};
---

<MainLayout title="Aanbod">
  <section class="section--full section--white section--center">
    <div class="content-width section--center section--col text--center">
      <SectionTitle title="Aanbod" heading="h1" />
      <div class="text-width">
        <p class="lead">
          Mijn aanbod is breed en gericht op kinderen, jongeren,
          jongvolwassenen, hun omgeving en professionals.
        </p>
        <p class="lead">
          Afhankelijk van de vraag en de context zoeken we samen naar een
          passende vorm van begeleiding. We bekijken samen wat helpend is en
          stemmen dit voortdurend af, zodat therapie een plek wordt waar groei,
          veiligheid en verandering mogelijk worden.
        </p>
      </div>
      <Button href="#aanbod" variant="down" content="Ontdek het aanbod" />
    </div>
  </section>

  <section id="aanbod" class="section section--center">
    <div class="content-width">
      <div
        class="service-cards"
        data-aos="zoom-in"
        data-aos-delay="200"
        data-aos-duration="600"
      >
        {
          services.map((card, index) => (
            <Card
              index={index}
              href={`#${card.id}`}
              title={card.title}
              text={card.intro}
              variant="white"
              icon={card.icon}
              iconColors={{
                main: "var(--teal)",
              }}
              opacity="0.8"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--small services-detail">
    <div class="content-width">
      {
        services.map((service, index) => (
          <article
            data-aos="fade-in"
            data-aos-delay="300"
            data-aos-duration="600"
            class="section--xs"
            id={service.id}
            class:list={["service-detail", { teal: index % 2 === 1 }]}
          >
            <div class="service-title">
              <Icon name={service.icon} />
              <SectionTitle
                heading="h2"
                title={service.title}
                variant="no-margin"
              />
            </div>

            <div class="service-description">
              <p class="eyebrow">{service.intro}</p>

              {service.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {service.list && (
                <ul>
                  {service.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- EMDR SECTION -->

  <section
    data-aos="fade-in"
    data-aos-delay="300"
    data-aos-duration="600"
    class="section--small section--emdr"
  >
    <div class="content-width section--center section--col">
      <SectionTitle heading="h2" title={emdr.title} variant="no-margin" />
    </div>

    <section class="section--small section--center section--col emdr-container">
      {
        emdr.paragraphs.map((paragraph) => (
          <p class="lead">
            {paragraph}
          </p>
        ))
      }
    </section>
  </section>

   <CTA title="Nog vragen?" sub="Stel ze gerust." variant="aanbod" />
</MainLayout>

<style>
  .service-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .services-detail {
    background: var(--cream);
  }

  .service-detail {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: var(--space-xxl);
    padding: var(--space-xl);
  }

  .service-detail.teal {
    background: var(--white);
    color: var(--teal);
    box-shadow: var(--shadow);
    border-radius: var(--radius-md);
  }

  .service-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-sm);
  }

  .service-description {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
  }

  .section--emdr {
    background-image: url("../assets/eye.png");
    background-color: var(--teal-dark);
    background-size: 75%;
    background-repeat: no-repeat;
    background-position: center 48%;
    overflow: hidden;
    color: var(--white);
  }

  .emdr-container {
    justify-self: center;
    background-color: rgba(0, 0, 0, 0.7);
    width: fit-content;
    color: var(--white);
    padding: var(--space-xs);
  }

  @media (max-width: 800px) {
    .service-overview {
      grid-template-columns: 1fr 1fr;
    }

    .service-detail {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 550px) {
    .service-overview {
      grid-template-columns: 1fr;
    }
  }
</style>
