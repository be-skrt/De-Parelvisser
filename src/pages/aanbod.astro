const services = [
  {
    id: "ouder-kind",
    title: "Ouder-kind gesprekken",
    intro:
      "Voor jonge ouders, baby's en peuters staat de relatie tussen ouder en kind centraal.",
    paragraphs: [
      "Bij de allerkleinsten werk ik steeds samen met de ouder(s). Het jonge kind kan zich nog niet via woorden uitdrukken, waardoor de relatie met de ouder de belangrijkste ingang vormt.",
      "We vertrekken vanuit hechting en co-regulatie: hoe kunnen ouder en kind elkaar beter aanvoelen, tot rust komen en op elkaar afgestemd raken?",
      "We kijken samen naar signalen van het kind, naar de interactie tussen ouder en kind en naar wat helpend kan zijn in het versterken van veiligheid en verbinding.",
    ],
  },

  {
    id: "diagnostiek",
    title: "Diagnostiek",
    intro:
      "Diagnostiek helpt om beter te begrijpen wat er speelt en wat nodig is.",
    paragraphs: [
      "Ik werk niet enkel met testen, maar kijk samen met jou naar het geheel: via gesprekken, observaties en waar nodig aanvullend onderzoek.",
      "We zoeken naar samenhang en betekenis, zodat duidelijk wordt wat helpend kan zijn in het verdere traject.",
    ],
    list: [
      "Intelligentietest",
      "Hechtingsonderzoek",
      "Belevingsonderzoek",
      "Vragenlijsten",
      "Klasobservatie",
    ],
  },

  {
    id: "therapie",
    title: "Individuele therapie",
    intro:
      "Een veilige ruimte waarin kinderen, jongeren en jongvolwassenen op hun eigen tempo kunnen stilstaan bij wat moeilijk loopt.",
    paragraphs: [
      "De manier van werken wordt steeds afgestemd op leeftijd, ontwikkeling en persoonlijke noden.",
      "Therapie is geen vaststaand programma, maar een traject op maat.",
    ],
  },

  {
    id: "ouders-gezin",
    title: "Ouders & gezin",
    intro:
      "Ondersteuning rond opvoeding, relaties en gezinsdynamieken.",
    paragraphs: [
      "Ouderbegeleiding biedt een plek om stil te staan bij vragen en onzekerheden in de opvoeding.",
      "In gezinstherapie staat de interactie binnen het gezin centraal. Moeilijkheden worden bekeken in de context van relaties en onderlinge dynamieken.",
    ],
  },

  {
    id: "context",
    title: "Contextbegeleiding",
    intro:
      "Soms spelen moeilijkheden zich niet alleen binnen het gezin af.",
    paragraphs: [
      "Waar nodig en steeds in overleg kunnen ook school, vriendenkring of andere belangrijke omgevingen betrokken worden.",
      "Dit helpt om een vollediger beeld te krijgen en meer afgestemde ondersteuning te bieden.",
    ],
  },

  {
    id: "professionals",
    title: "Professionals",
    intro:
      "Ook professionals kunnen terecht voor ondersteuning en verdieping in hun werk.",
    paragraphs: [
      "Ik bied supervisie, intervisie en vorming aan, afgestemd op de werkcontext en de noden van de professional.",
    ],
  },
];
---

<MainLayout title="Aanbod">
  <section class="page-hero section--white section--center">
    <div class="content-width section section--center section--col text--center">
      <SectionTitle title="Aanbod" heading="h1" />
      <p>
        Mijn aanbod is breed en gericht op kinderen, jongeren, jongvolwassenen, hun omgeving en professionals.
      </p>
      <p>
        Afhankelijk van de vraag en de context zoeken we samen naar een passende vorm van begeleiding. We bekijken samen wat helpend is en stemmen dit voortdurend af, zodat therapie een plek wordt waar groei, veiligheid en verandering mogelijk worden.
      </p>
    </div>
  </section>

  <section id="aanbod" class="section">
    <div class="content-width">
      <div class="service-overview">
        {
          services.map((service) => (
            <a href={`#${service.id}`} class="overview-card">

              <h2>{service.title}</h2>

              <p>{service.intro}</p>

              <span>Lees meer →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section services-detail">
    <div class="content-width">
      {
        services.map((service, index) => (
          <article id={service.id} class:list={["service-detail", { dark: index % 2 === 1 }]}>
            <div>
              <h2>{service.title}</h2>
            </div>

            <div>
              <p class="service-intro">{service.intro}</p>

              {service.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}

              {service.list && (
                <ul>
                  {service.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="contact-strip">
    <div class="content-width">
      <div>
        <p class="eyebrow">Nog vragen?</p>
        <h2>We bekijken samen wat mogelijk is.</h2>
      </div>

      <Button content="Contact opnemen" />
    </div>
  </section>

  <!-- CONTEXT SECTION -->

  <section class="section section--full section--sage">
    <div class="content-width">
      <p class="eyebrow">Context</p>
      <h2>Samen zoeken</h2>
      <p>
        Omdat moeilijkheden vaak verbonden zijn met de relaties waarin iemand
        leeft, betrek ik waar nodig de context. Dit kan het gezin zijn, maar ook
        school of andere belangrijke omgevingen.
      </p>
      <p>
        Ik werk in verschillende vormen: soms individueel, soms met ouders, soms
        samen met het kind of de jongere en zijn of haar omgeving. Dit gebeurt
        steeds in overleg en afstemming.
      </p>
    </div>
  </section>

  <!-- EMDR SECTION -->

  <section class="section section--full">
    <div class="content-width story-grid">
      <div class="story-content">
        <p class="eyebrow">EMDR</p>
        <h2>{titlePlaceholder}</h2>
        <p>
          In sommige situaties kan <strong>EMDR</strong> helpend zijn, bijvoorbeeld
          wanneer ingrijpende ervaringen blijven doorwerken in het dagelijks leven.
        </p>

        <p>
          EMDR (Eye Movement Desensitization and Reprocessing) is een
          psychotherapeutische behandelmethode die onder meer wordt gebruikt bij
          traumatische ervaringen en angstklachten.
        </p>
      </div>
      <figure class="story-image">
        <img src="/images/eye.png" alt="Oog" />
      </figure>
    </div>
  </section>
</MainLayout>

<style>
  .service-overview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .overview-card {
    min-height: 280px;

    display: flex;
    flex-direction: column;

    padding: 2rem;

    border-radius: var(--radius-md);

    background: var(--white);
    box-shadow: var(--shadow-card);

    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .overview-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-soft);
  }

  .card-number {
    color: var(--gold);

    font-family: "Montserrat", sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  .overview-card h2 {
    margin-top: auto;
    margin-bottom: 1rem;
  }

  .overview-card p {
    color: var(--muted);
  }

  .overview-card > span:last-child {
    margin-top: auto;

    color: var(--gold);

    font-family: "Montserrat", sans-serif;
    font-size: 0.85rem;
  }

  .services-detail {
    background: var(--cream);
  }

  .service-detail {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: 6rem;
    padding-block: 6rem;
  }

  .service-detail.dark {
    margin-inline: calc((var(--content-max-width) - 100vw) / 2);
    padding-inline: max(
      calc((100vw - var(--content-max-width)) / 2),
      1rem
    );

    background: var(--teal);
    color: var(--white);
  }

  .service-detail h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .service-intro {
    font-size: 1.3rem;
  }

  .service-detail ul {
    margin-top: 2rem;
  }

  .service-detail li {
    margin-bottom: 0.5rem;
  }

  .contact-strip {
    padding-block: 3rem;
    background: var(--sage);
  }

  .contact-strip > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .contact-strip h2 {
    color: var(--teal);
  }

  @media (max-width: 800px) {
    .service-overview {
      grid-template-columns: 1fr 1fr;
    }

    .service-detail {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-strip > div {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 550px) {
    .service-overview {
      grid-template-columns: 1fr;
    }
  }
</style>