---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Card from "../components/Card.astro";

const clientName = "Griet Ackerman";
const businessName = "De Parelvisser";

const services = [
  {
    title: "Ouder-kind gesprekken",
    text: "Begeleiding rond verbinding, hechting en de relatie tussen ouder en kind.",
    href: "/aanbod#ouder-kind",
  },
  {
    title: "Diagnostiek",
    text: "Samen onderzoeken en begrijpen wat er speelt en welke ondersteuning nodig is.",
    href: "/aanbod#diagnostiek",
  },
  {
    title: "Individuele therapie",
    text: "Therapie voor kinderen, jongeren en jongvolwassenen, afgestemd op hun noden.",
    href: "/aanbod#therapie",
  },
  {
    title: "Ouderbegeleiding & gezinstherapie",
    text: "Ondersteuning rond opvoeding, relaties en gezinsdynamieken.",
    href: "/aanbod#ouders-gezin",
  },
  {
    title: "Professionals",
    text: "Supervisie, intervisie en vorming voor professionals.",
    href: "/aanbod#professionals",
  },
];
---

<MainLayout title="Home">
  <Hero businessName={businessName} />

  <!-- INTRODUCTION -->

  <section class="section--full section--center section--teal">
    <div class="content-width about-grid">
      <div
        class="about-image"
        data-aos="fade-right"
        data-aos-duration="800"
        data-aos-delay="100"
      >
        <img src="/images/griet-ackerman.jpg" alt={clientName} />
      </div>

      <div
        class="about-content"
        data-aos="fade-left"
        data-aos-duration="800"
        data-aos-delay="100"
      >
        <p class="eyebrow">Wie ben ik?</p>
        <h2>
          Ik ben {clientName}, psychotherapeut en oprichter van
          <span> {businessName}</span>.
        </h2>
        <p>
          In mijn praktijk kijken we samen naar wat er speelt, met aandacht voor
          wie je bent, je verhaal en de context waarin je leeft.
        </p>
        <p>
          Vanuit een veilige en respectvolle ruimte gaan we op zoek naar wat kan
          helpen om opnieuw verbinding te vinden met jezelf en met anderen.
        </p>
        <Button href="/over-mij" variant="light" content="Meer over mij" />
      </div>
    </div>
  </section>

  <!-- SERVICES -->

  <section class="section">
    <div class="content-width">
      <div class="heading section--center section--col">
        <SectionTitle title="Waarmee kan ik je helpen?" heading="h2" />
        <p>
          Elke begeleiding wordt afgestemd op de persoon, de vraag en de
          context.
        </p>
      </div>

      <div class="service-grid">
        {
          services.map((service, index) => (
            <Card
              index={index}
              href={service.href}
              title={service.title}
              text={service.text}
              variant="cream"
            />
          ))
        }
      </div>

      <Button href="/aanbod" content="Bekijk het volledige aanbod" />
    </div>
  </section>

  <!-- CTA -->

  <section class="section home-cta">
    <div class="content-width">
      <div class="cta-inner">
        <div>
          <h2>Heb je een vraag?</h2>
          <p>Neem gerust contact op. We bekijken samen wat mogelijk is.</p>
        </div>

        <Button href="/contact" content="Contact opnemen" />
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) 1fr;
    align-items: center;
    gap: var(--space-xxxl);
  }

  .about-image {
    width: clamp(220px, 30vw, 360px);
  }

  .about-image img {
    border-radius: 50%;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1rem;
  }

  .about-content .eyebrow {
    color: var(--gold-light);
  }

  .about-content span {
    display: inline;
    align-self: flex-end;

    color: var(--gold);

    font-family: "Montserrat", sans-serif;
    font-weight: 300;
    font-size: var(--fsz-xl);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    margin-bottom: var(--space-lg);
  }

  .services-button {
    margin-top: 2.5rem;
    text-align: center;
  }

  .home-cta {
    padding-block: var(--space-md);
    background: rgba(170, 201, 195, 0.5);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    border-radius: 20px;
    background: linear-gradient(
      to right,
      rgba(246, 242, 235, 1) 0%,
      rgba(246, 242, 235, 0.5) 60%,
      rgba(246, 242, 235, 0) 100%
    );
  }

  .cta-inner h2 {
    margin: 1rem 0;
    color: var(--gold);
  }

  .cta-inner p {
    margin: 0;
    color: var(--teal);
  }

  @media (max-width: 1000px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
      gap: 3rem;
    }
  }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-image {
      max-width: 400px;
      margin-inline: auto;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem;
    }
  }
</style>
