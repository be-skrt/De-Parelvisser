---
import MainLayout from "../layouts/MainLayout.astro";
// Components
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import SectionTitle from "../components/SectionTitle.astro";
import CTA from "../components/CTA.astro";
// Images
import grietPic from "/src/assets/griet-ackerman.jpg";
import { Image } from "astro:assets";
import CardGrid from "../components/CardGrid.astro";

const clientName = "Griet Ackerman";
const businessName = "De Parelvisser";

// Data
const services = [
  {
    title: "Ouder-kind gesprekken",
    text: "Begeleiding rond verbinding, hechting en de relatie tussen ouder en kind.",
    href: "aanbod#ouder-kind",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    title: "Diagnostiek",
    text: "Samen onderzoeken en begrijpen wat er speelt en welke ondersteuning nodig is.",
    href: "aanbod#diagnostiek",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    title: "Individuele therapie",
    text: "Therapie voor kinderen, jongeren en jongvolwassenen, afgestemd op hun noden.",
    href: "aanbod#therapie",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    title: "Ouderbegeleiding & gezinstherapie",
    text: "Ondersteuning rond opvoeding, relaties en gezinsdynamieken.",
    href: "aanbod#ouders-gezin",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    title: "Professionals",
    text: "Supervisie, intervisie en vorming voor professionals.",
    href: "aanbod#professionals",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
];
---

<MainLayout title="Home" headerBackground="cream">
  <Hero businessName={businessName} />

  <!-- INTRODUCTION -->

  <section
    class="section--full section--center section--teal section--pearls-white"
  >
    <div class="content-width about-grid">
      <figure
        class="about-image"
        data-aos="fade-in"
        data-aos-duration="1000"
        data-aos-delay="400"
      >
        <Image
          src={grietPic}
          alt={clientName}
          width={360}
          height={360}
          class="about-img"
        />
      </figure>

      <div
        class="about-content"
        data-aos="fade-left"
        data-aos-duration="800"
        data-aos-delay="100"
      >
        <p class="eyebrow">Wie ben ik?</p>
        <h2>
          Ik ben {clientName}, psycholoog en oprichter van
          <span class="text--gold"> {businessName}</span>.
        </h2>
        <p>
          In mijn praktijk kijken we samen naar wat er speelt, met aandacht voor
          wie je bent, je verhaal en de context waarin je leeft.
        </p>
        <p>
          Vanuit een veilige en respectvolle ruimte gaan we op zoek naar wat kan
          helpen om opnieuw verbinding te vinden met jezelf en met anderen.
        </p>
        <Button
          href=`${import.meta.env.BASE_URL}/over-mij`
          variant="light"
          content="Meer over mij"
        />
      </div>
    </div>
  </section>

  <!-- SERVICES -->

  <section class="section">
    <div class="content-width">
      <div class="heading section--center section--col">
        <SectionTitle title="Waarmee kan ik je helpen?" heading="h2" />
        <p class="lead">
          Elke begeleiding wordt afgestemd op de persoon, de vraag en de
          context.
        </p>
      </div>

      <CardGrid columns="5" items={services} />

      <Button
        href=`${import.meta.env.BASE_URL}/aanbod`
        content="Bekijk het volledige aanbod"
      />
    </div>
  </section>

  <!-- CTA -->

  <CTA
    title="Heb je een vraag?"
    sub="Neem gerust contact op. We bekijken samen wat mogelijk is."
    variant="home"
  />
</MainLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.8fr) 1fr;
    align-items: center;
    gap: var(--space-xxxl);
  }

  .about-image {
    width: clamp(120px, 100%, 360px);
    box-shadow: 0 0 300px rgba(95, 147, 153, 0.8);
    border-radius: var(--radius-pill);

    @media (max-height: 861px) {
      box-shadow: 0 0 20px rgba(95, 147, 153, 0.5);
    }
  }

  .about-img {
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
  }

  .about-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .about-content .eyebrow {
    color: var(--gold-light);
  }

  .about-content h2 {
    margin-bottom: var(--space-sm);
  }

  .about-content span {
    display: inline;
    align-self: flex-end;
    color: var(--gold);
    font-family: "Montserrat", sans-serif;
    font-weight: 300;
    font-size: var(--fsz-xl);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .services-button {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (max-width: 1000px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
      gap: 3rem;
    }
  }

  @media (max-width: 700px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-image {
      max-width: 400px;
      margin-inline: auto;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
