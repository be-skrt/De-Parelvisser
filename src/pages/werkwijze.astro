---
import Icon from "../components/icons/Icon.astro";
import SectionTitle from "../components/SectionTitle.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import imgKinderen from "../assets/aquarium.jpg";
import imgJongeren from "../assets/youth.jpg";
import imgJongvolwassenen from "../assets/adolescents.jpg";
import CardGrid from "../components/CardGrid.astro";

const audience = [
  {
    id: "kinderen",
    target: "Kinderen",
    title: "Spelen, ontdekken en begrijpen",
    paragraphs: [
      "Elk kind ontwikkelt zich op zijn eigen tempo en manier. Soms loopt dat vanzelf, soms zijn er vragen of zorgen. Ik bied een veilige plek waar kinderen en hun ouders terechtkunnen voor ondersteuning en begeleiding.",
      "Bij jonge kinderen maak ik gebruik van speltherapie, zoals spelen, tekenen en verhalen. Spel is hun natuurlijke taal en biedt een ingang om gevoelens, ervaringen en vragen zichtbaar te maken.",
    ],
    image: imgKinderen,
    imageAlt: "Kind bij aquarium",
    options: [
      "Diagnostiek op maat",
      "Individuele therapie",
      "Spel en creatieve werkvormen",
      "Ouderbegeleiding",
      "Gezinstherapie",
      "Contextbegeleiding",
    ],
  },
  {
    id: "jongeren",
    target: "Jongeren",
    title: "Ruimte om stil te staan",
    paragraphs: [
      "De adolescentie is een periode vol veranderingen en uitdagingen. Soms kan het helpend zijn om even stil te staan bij wat er leeft en ondersteuning te krijgen.",
      "Wij bieden jongeren een plek waar ze zichzelf kunnen zijn en waar er samen gezocht wordt naar wat hen kan helpen groeien.",
    ],
    image: imgJongeren,
    imageAlt: "Jongere op het strand",
    options: [
      "Diagnostiek",
      "Individuele therapie",
      "Gezinstherapie",
      "Ouderbegeleiding",
      "Contextbegeleiding",
      "EMDR",
    ],
  },
  {
    id: "jongvolwassenen",
    target: "Jongvolwassenen",
    title: "Zoeken naar richting en evenwicht",
    paragraphs: [
      "In de overgang naar volwassenheid komen vaak belangrijke vragen naar boven rond identiteit, relaties en richting in het leven.",
      "We zoeken samen naar meer inzicht, houvast en verbinding. Er is ruimte om stil te staan bij persoonlijke vragen, keuzes en wat je nodig hebt om verder te kunnen.",
    ],
    image: imgJongvolwassenen,
    imageAlt: "Jongvolwassenen aan de zee",
    options: [
      "Individuele therapie",
      "Reflectie rond identiteit en relaties",
      "Cognitieve en inzichtgevende technieken",
      "Stressregulatie",
      "EMDR",
      "Contextbegeleiding",
    ],
  },
];

const audienceCards = [
  {
    href: "#kinderen",
    title: "Kinderen",
    text: "Een veilige plek waar kinderen en hun ouders terechtkunnen voor ondersteuning en begeleiding.",
    variant: "teal",
    icon: "oyster",
    iconColors: {
      main: "var(--teal-light)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    href: "#jongeren",
    title: "Jongeren",
    text: "Ruimte om stil te staan bij wat leeft en samen te zoeken naar wat kan helpen groeien.",
    variant: "teal",
    icon: "oyster",
    iconColors: {
      main: "var(--teal-light)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    href: "#jongvolwassenen",
    title: "Jongvolwassenen",
    text: "Ondersteuning rond identiteit, relaties, evenwicht en persoonlijke groei.",
    variant: "teal",
    icon: "oyster",
    iconColors: {
      main: "var(--teal-light)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    href: "#professionelen",
    title: "Professionelen",
    text: "Supervisie, intervisie en vorming voor wie zich professioneel wil verdiepen.",
    variant: "teal",
    icon: "oyster",
    iconColors: {
      main: "var(--teal-light)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
];

const professionalCards = [
  {
    title: "Supervisie",
    text: "Ruimte om stil te staan bij je werk en je professionele handelen te onderzoeken.",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    title: "Intervisie",
    text: "Samen reflecteren, ervaringen uitwisselen en leren van elkaars perspectieven.",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
  {
    title: "Vorming",
    text: "Vorming en trainingen op maat van jouw werkcontext en specifieke vragen.",
    variant: "cream",
    icon: "oyster",
    iconColors: {
      main: "var(--teal)",
      secondary: "var(--gold)",
    },
    opacity: "var(--opacity-strong)",
  },
];

const process = [
  {
    step: "1",
    title: "Kennismaken",
    text: "Tijdens een intake en enkele verkennende gesprekken maken we ruimte om elkaar te leren kennen en te ontdekken wat er speelt.",
    icon: "meet",
  },
  {
    step: "2",
    title: "Verhelderen",
    text: "We brengen samen in kaart wat moeilijk loopt, wat belangrijk is en wat eventueel verder onderzocht moet worden.",
    icon: "lightbulb",
  },
  {
    step: "3",
    title: "Plan maken",
    text: "Vanuit wat we ontdekken, bepalen we samen welke veranderingen je wenst en wat daarbij kan helpen.",
    icon: "plan",
  },
  {
    step: "4",
    title: "Bijsturen",
    text: "Doorheen het traject blijven we samen kijken wat helpend is. Waar nodig sturen we bij.",
    icon: "feedback",
  },
];
---

<MainLayout title="Werkwijze" headerBackground="white">
  <section class="section--full section--white section--center">
    <div class="content-width section--center section--col text--center">
      <SectionTitle title="Werkwijze" heading="h1" />
      <p>
        Ieder mens beschikt over innerlijke kwaliteiten en veerkracht. Soms zijn
        die niet meteen zichtbaar, omdat ze verscholen liggen onder wat moeilijk
        loopt of zwaar aanvoelt.
      </p>

      <p>
        In therapie nemen we de tijd om te vertragen, te verhelderen en te
        ontdekken wat voor jou — of voor je kind — waardevol is.
      </p>

      <p class="eyebrow">
        Zoals een parelvisser die met geduld en zachtheid naar de diepte gaat.
      </p>
    </div>
  </section>

  <!-- DIVER SECTION -->

  <section class="section--diver">
    <div class="content-width diver">
      <div
        class="diver-content"
        data-aos="zoom"
        data-aos-duration="800"
        data-aos-delay="400"
      >
        <p class="eyebrow">Aanpak op maat</p>
        <h2>Begrijpen wat er speelt</h2>

        <p>
          Ik werk met kinderen, jongeren, jongvolwassenen en hun context. Samen
          gaan we op zoek naar wat er speelt en wat helpend kan zijn, telkens
          afgestemd op jouw situatie.
        </p>
        <p>
          Mijn manier van werken is rustig en betrokken. Ik vertrek niet vanuit
          één vaste methode, maar kijk samen wat nodig is.
        </p>
      </div>
    </div>
  </section>

  <!-- AUDIENCE CARD SECTION -->

  <section class="section--small section--teal-dark">
    <div class="content-width section--col section--center">
      <div
        class="heading section--center section--col text--center"
        data-aos="fade-down"
        data-aos-duration="800"
      >
        <SectionTitle title="Hoe ga ik te werk?" heading="h2" />
        <p class="lead">
          Geen twee trajecten zijn hetzelfde. Afhankelijk van je vraag, leeftijd
          en context bekijken we samen welke vorm van begeleiding aansluit.
        </p>
      </div>
      <CardGrid
        columns="4"
        items={audienceCards}
        data-aos="zoom-in"
        data-aos-delay="200"
        data-aos-duration="600"
      />
    </div>
  </section>

  <!-- AUDIENCE SECTION -->

  <section>
    {
      audience.map((item, index) => {
        const isEven = index % 2 === 0;
        const leftAnimation = "fade-right";
        const rightAnimation = "fade-left";

        const imageAnimation = isEven ? leftAnimation : rightAnimation;
        const contentAnimation = isEven ? rightAnimation : leftAnimation;

        return (
          <section
            id={item.id}
            class:list={[
              "section",
              "section--center",
              "section--col",
              isEven
                ? [
                    "section--teal",
                    index === 0
                      ? "section--pearl-white"
                      : "section--pearl-white-2",
                  ]
                : ["section--white", "section--pearls-teal"],
            ]}
          >
            <div class="heading content-width section--center section--col text--center">
              <p class="eyebrow">{item.target}</p>
              <SectionTitle title={item.title} heading="h2" />
            </div>

            <div class="content-width">
              <div
                class:list={["story-grid", { "story-grid--reverse": !isEven }]}
              >
                <div
                  class="grid-items"
                  data-aos={imageAnimation}
                  data-aos-duration="1000"
                  data-aos-delay="200"
                >
                  <figure class="story-image">
                    <Image
                      src={item.image}
                      alt={item.imageAlt}
                      format="webp"
                      class="story-img"
                      loading="eager"
                      fetchpriority="high"
                    />
                  </figure>
                </div>

                <div
                  class="grid-items grid-content"
                  data-aos={contentAnimation}
                  data-aos-duration="1000"
                  data-aos-delay="200"
                >
                  <div class="story-content">
                    {item.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>

                  <div class="options-container">
                    <h3 class="text--gold">Wat kan aan bod komen?</h3>

                    <ul class="options-list">
                      {item.options.map((option) => (
                        <li>{option}</li>
                      ))}
                    </ul>

                    {isEven ? (
                      <Button
                        href={`${import.meta.env.BASE_URL}/aanbod#aanbod`}
                        content="Bekijk aanbod"
                      />
                    ) : (
                      <Button
                        href={`${import.meta.env.BASE_URL}/aanbod#aanbod`}
                        variant="light"
                        content="Bekijk aanbod"
                      />
                    )}
                  </div>
                </div>
              </div>
            </div>
          </section>
        );
      })
    }
  </section>

  <!-- PROFESSIONALS SECTION -->

  <section id="professionelen" class="section--small">
    <div class="content-width">
      <div class="heading section--center section--col text--center">
        <p class="eyebrow">Professionelen</p>
        <SectionTitle title="Ruimte voor verdieping" heading="h2" />
        <p class="lead">
          Ook collega's en andere professionals zijn welkom voor uitwisseling,
          verdieping en professionele groei.
        </p>
      </div>
      <CardGrid columns="3" items={professionalCards} />
    </div>
  </section>

  <!-- PROCESS SECTION -->

  <section class="section section--full section--white section--center">
    <div class="content-width">
      <div
        class="heading section--center section--col text--center"
        data-aos="fade-down"
        data-aos-duration="600"
      >
        <p class="eyebrow">Het traject</p>
        <SectionTitle title="Samen zoeken, samen bijsturen" heading="h2" />
        <p class="lead">
          Een traject staat nooit volledig op voorhand vast en kan steeds
          bijgestemd worden, afhankelijk van de noden.
        </p>
      </div>

      <div
        class="process"
        data-aos="zoom-out"
        data-aos-duration="800"
        data-aos-delay="200"
      >
        <div class="process-line" aria-hidden="true"></div>
        {
          process.map((step) => {
            return (
              <article class="process-step">
                <div class="process-icon">
                  <Icon name={step.icon} />
                </div>
                <h3 class="process-title">
                  {step.step}. {step.title}
                </h3>
                <p>{step.text}</p>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</MainLayout>
<script>
  document
    .querySelectorAll<HTMLElement>(
      ".section--pearls-white, .section--pearls-teal",
    )
    .forEach((section) => {
      const beforeDuration = 6 + Math.random() * 6;
      const afterDuration = 6 + Math.random() * 6;

      section.style.setProperty(
        "--float-before-duration",
        `${beforeDuration}s`,
      );
      section.style.setProperty("--float-after-duration", `${afterDuration}s`);
    });
</script>

<style>
  .section--full .eyebrow {
    margin-top: 2.5rem;

    @media (max-width: 500px) {
      margin: 0;
    }
  }

  .section--diver {
    position: relative;
    height: calc(50vh + var(--header-height));
    background-image: url("../assets/diver.jpg");
    background-size: cover;
    background-attachment: fixed;
    background-position: center 35%;
    color: var(--white);

    @media (max-width: 800px) {
      height: fit-content;
      background-position-x: 20%;
    }
  }

  .section--diver h2 {
    margin-bottom: var(--space-sm);
  }

  .diver {
    height: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .diver-content {
    width: 45%;
    text-align: right;
  }

  @media (max-width: 800px) {
    .diver-content {
      background: rgba(40, 83, 90, 0.2);
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: center;
      align-items: center;
      padding: 1rem;
    }

    .diver-content p {
      max-width: auto;
    }

    .diver-content,
    .diver-content p {
      text-align: center;
    }
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-sm);
  }

  @media (max-width: 1100px) {
    .audience-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .audience-grid {
      grid-template-columns: 1fr;
    }
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 700px) {
    .story-grid,
    .story-grid.reverse {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
  }

  .story-grid--reverse .grid-items:first-child {
    grid-column: 2;
    grid-row: 1;
  }

  .story-grid--reverse .grid-items:last-child {
    grid-column: 1;
    grid-row: 1;
  }

  .story-image {
    width: 100%;
    align-self: center;
  }

  .story-img {
    width: 100%;
    min-width: 100%;
    min-height: 20vh;
    max-height: 550px;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: 0 5px 15px rgba(15, 35, 39, 0.5);

    @media (max-width: 700px) {
      max-height: 50vw;
    }
  }

  .story-content p {
    @media (max-width: 700px) {
      max-width: fit-content;
    }
  }

  .grid-items {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xs);
    width: 100%;
  }

  .options-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    position: relative;
    width: 100%;
    padding: var(--space-md);
    border: none;
    border-radius: var(--radius-md);
    box-shadow: 0 5px 15px rgba(15, 35, 39, 0.5);
    overflow: hidden;
  }

  .options-list {
    z-index: 5;
  }

  .section--teal .options-container {
    background: var(--white);
    color: var(--teal);
  }

  .section--white .options-container {
    background: var(--teal);
    color: var(--white);
  }

  .section--white .options-container::after {
    content: "";
    position: absolute;
    right: -30px;
    bottom: -20px;
    width: 200px;
    height: 200px;
    opacity: var(--opacity-medium);
    mask: url("../assets/oyster.svg") no-repeat;
    mask-size: contain;
    transform: rotate(8deg);
    background-color: var(--white);
    z-index: 1;
  }

  @media (max-width: 700px) {
    .section--white .options-container::after {
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      scale: 2.5;
      rotate: -8deg;
      opacity: 0.2;
    }
  }

  .section--teal .options-container::after {
    content: "";
    position: absolute;
    right: -30px;
    bottom: -20px;
    width: 200px;
    height: 200px;
    opacity: var(--opacity-solid);
    mask: url("../assets/oyster.svg") no-repeat;
    mask-size: contain;
    transform: rotate(8deg);
    background-color: var(--gold);
    z-index: 1;
  }

  @media (max-width: 700px) {
    .section--teal .options-container::after {
      top: 50%;
      left: 50%;
      translate: -50% -50%;
      scale: 2.5;
      rotate: -8deg;
      opacity: 0.2;
    }
  }

  .section--teal .options-container li::marker {
    color: var(--gold);
  }

  .professional-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-sm);

    @media (max-width: 500px) {
      grid-template-columns: 1fr;
    }
  }

  .process {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;

    @media (max-width: 786px) {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    @media (max-width: 500px) {
      display: flex;
      flex-direction: column;
    }
  }

  .process-line {
    position: absolute;
    top: 3.5rem;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: var(--gold);
    opacity: var(--opacity-heavy);
    z-index: 0;

    @media (max-width: 786px) {
      display: none;
    }
  }

  .process-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 1;
  }

  .process-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7rem;
    height: 7rem;
    margin-bottom: var(--space-md);
    padding: var(--space-sm);
    background: var(--white);
    border: 2px solid var(--gold);
    border-radius: var(--radius-pill);

    @media (max-width: 500px) {
      width: 5rem;
      height: 5rem;
    }
  }

  .process-step h3 {
    margin-bottom: 0.75rem;
    color: var(--gold);
    font-family: "Montserrat", sans-serif;
    font-size: var(--fsz-lg);
    font-weight: bold;
  }

  .process-step p {
    max-width: 270px;
    margin: 0 auto;

    color: var(--teal-dark);

    font-size: var(--fsz-md);
  }
</style>
