---
// imports
import "aos/dist/aos.css";
import "../styles/reset.css";
import "../styles/global.css";
// components
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollButton from "../components/ScrollButton.astro";

interface Props {
  title: string;
  description: string;
  headerBackground?: "cream" | "white" | "transparent";
}

const { title, description, headerBackground = "transparent" } = Astro.props;
---

<html lang="nl">
  <Head title={title} description={description} />
  <body>
    <Header
      currentPath={Astro.url.pathname}
      headerBackground={headerBackground}
    />
    <main>
      <slot />
      <ScrollButton />
    </main>
    <Footer />
    <script>
      import AOS from "aos";

      AOS.init({
        disable: "phone",
      });
    </script>
    <script src="../scripts/scroll.js"></script>
    <script src="../scripts/scrollButton.js"></script>
    <script src="../scripts/menu.js"></script>
    <script src="../scripts/floatingBubbles.js"></script>
  </body>
</html>
